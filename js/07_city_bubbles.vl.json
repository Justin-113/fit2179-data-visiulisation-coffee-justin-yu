{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "description": "Australia map with bubble overlay sizing the five biggest cities by caf\u00e9 count from OpenStreetMap.",
    "height": "container",
    "padding": 12,
    "projection": {
        "type": "mercator",
        "center": [
            134,
            -27
        ],
        "scale": 700
    },
    "layer": [
        {
            "data": {
                "url": "data/australian-states.json",
                "format": {
                    "type": "json",
                    "property": "features"
                }
            },
            "mark": {
                "type": "geoshape",
                "fill": "#EFE6D2",
                "stroke": "#D6C9B0",
                "strokeWidth": 0.6
            }
        },
        {
            "data": {
                "url": "data/city_cafes.csv"
            },
            "mark": {
                "type": "circle",
                "stroke": "#F5F1EA",
                "strokeWidth": 2,
                "opacity": 0.85
            },
            "encoding": {
                "longitude": {
                    "field": "lon",
                    "type": "quantitative"
                },
                "latitude": {
                    "field": "lat",
                    "type": "quantitative"
                },
                "size": {
                    "field": "cafes_total",
                    "type": "quantitative",
                    "scale": {
                        "type": "sqrt",
                        "domain": [
                            500,
                            3200
                        ],
                        "range": [
                            250,
                            3500
                        ]
                    },
                    "legend": null
                },
                "color": {
                    "field": "cafes_total",
                    "type": "quantitative",
                    "scale": {
                        "domain": [
                            500,
                            3200
                        ],
                        "range": [
                            "#6F9B8C",
                            "#2F5D50"
                        ]
                    },
                    "legend": null
                },
                "tooltip": [
                    {
                        "field": "city",
                        "type": "nominal",
                        "title": "City"
                    },
                    {
                        "field": "cafes_total",
                        "type": "quantitative",
                        "title": "Caf\u00e9s (OSM)",
                        "format": ","
                    },
                    {
                        "field": "cafes_independent",
                        "type": "quantitative",
                        "title": "Independent",
                        "format": ","
                    },
                    {
                        "field": "cafes_chain",
                        "type": "quantitative",
                        "title": "Chain",
                        "format": ","
                    },
                    {
                        "field": "chain_pct",
                        "type": "quantitative",
                        "title": "Chain share (%)",
                        "format": ".1f"
                    },
                    {
                        "field": "population",
                        "type": "quantitative",
                        "title": "Population",
                        "format": ","
                    },
                    {
                        "field": "per_10k",
                        "type": "quantitative",
                        "title": "Per 10k people",
                        "format": ".2f"
                    }
                ]
            }
        },
        {
            "data": {
                "url": "data/city_cafes.csv"
            },
            "mark": {
                "type": "text",
                "align": "center",
                "baseline": "bottom",
                "dy": -28,
                "fontSize": 13,
                "fontWeight": 700,
                "color": "#2A1B14"
            },
            "encoding": {
                "longitude": {
                    "field": "lon",
                    "type": "quantitative"
                },
                "latitude": {
                    "field": "lat",
                    "type": "quantitative"
                },
                "text": {
                    "field": "city",
                    "type": "nominal"
                }
            }
        },
        {
            "data": {
                "url": "data/city_cafes.csv"
            },
            "mark": {
                "type": "text",
                "align": "center",
                "baseline": "top",
                "dy": 32,
                "fontSize": 11,
                "fontWeight": 500,
