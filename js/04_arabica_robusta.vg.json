{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "description": "Scatter plot showing each country's coffee production positioned by total volume (log x) and Arabica share (y).",
    "height": "container",
    "padding": 16,
    "data": {
        "url": "data/coffee_species_scatter.csv"
    },
    "encoding": {
        "x": {
            "field": "total",
            "type": "quantitative",
            "scale": {
                "type": "log",
                "domain": [
                    150,
                    100000
                ],
                "nice": false
            },
            "axis": {
                "title": "Total production (1000 \u00d7 60-kg bags, log scale)",
                "titleFontSize": 12,
                "titlePadding": 14,
                "labelFontSize": 11,
                "values": [
                    200,
                    500,
                    1000,
                    2000,
                    5000,
                    10000,
                    20000,
                    50000
                ],
                "format": "~s",
                "grid": true,
                "gridDash": [
                    2,
                    4
                ]
            }
        },
        "y": {
            "field": "arabica_pct",
            "type": "quantitative",
            "scale": {
                "domain": [
                    -5,
                    110
                ]
            },
            "axis": {
                "title": "Share of Arabica",
                "titleFontSize": 12,
                "titlePadding": 10,
                "labelFontSize": 11,
                "values": [
                    0,
                    25,
                    50,
                    75,
                    100
                ],
                "format": ".0f",
                "labelExpr": "datum.value + '%'",
                "grid": true,
                "gridDash": [
                    2,
                    4
                ]
            }
        }
    },
    "layer": [
        {
            "mark": {
                "type": "rule",
                "color": "#8C7361",
                "strokeDash": [
                    3,
                    3
                ],
                "strokeWidth": 1,
                "opacity": 0.4
            },
            "data": {
                "values": [
                    {
                        "y": 50
                    }
                ]
            },
            "encoding": {
                "y": {
                    "field": "y",
                    "type": "quantitative"
                }
            }
        },
        {
            "mark": {
                "type": "circle",
                "opacity": 0.85,
                "stroke": "#F5F1EA",
                "strokeWidth": 1
            },
            "encoding": {
                "size": {
                    "field": "total",
                    "type": "quantitative",
                    "scale": {
                        "type": "sqrt",
                        "range": [
                            50,
                            1800
                        ]
                    },
                    "legend": null
                },
                "color": {
                    "field": "variety_mix",
                    "type": "nominal",
                    "scale": {
                        "domain": [
                            "Pure Arabica",
                            "Arabica-dominant",
                            "Mixed",
                            "Robusta-dominant",
                            "Pure Robusta"
                        ],
                        "range": [
                            "#2F5D50",
                            "#6F9B8C",
                            "#8C7361",
                            "#C77F66",
                            "#A53F2B"
                        ]
                    },
                    "legend": {
                        "title": "Variety mix",
                        "titleFontSize": 11,
                        "labelFontSize": 11,
                        "orient": "right",
                        "symbolType": "circle",
                        "symbolSize": 150
                    }
                },
                "tooltip": [
                    {
                        "field": "country",
                        "type": "nominal",
                        "title": "Country"
                    },
                    {
                        "field": "total",
                        "type": "quantitative",
                        "title": "Total (1000 bags)",
                        "format": ","
                    },
                    {
                        "field": "arabica_bags",
                        "type": "quantitative",
                        "title": "Arabica (1000 bags)",
                        "format": ","
                    },
                    {
                        "field": "robusta_bags",
                        "type": "quantitative",
                        "title": "Robusta (1000 bags)",
                        "format": ","
                    },
                    {
                        "field": "arabica_pct",
                        "type": "quantitative",
                        "title": "Arabica share",
                        "format": ".1f"
                    },
                    {
                        "field": "variety_mix",
                        "type": "nominal",
                        "title": "Category"
                    }
                ]
            }
        },
        {
            "transform": [
                {
                    "filter": "indexof(['Brazil','Vietnam','Indonesia','India'], datum.country) >= 0"
                }
            ],
            "mark": {
                "type": "text",
                "align": "center",
                "baseline": "middle",
                "dx": 0,
                "dy": 0,
                "fontSize": 12,
                "fontWeight": 600,
                "color": "#2A1B14"
            },
            "encoding": {
                "text": {
                    "field": "country"
                }
            }
        },
        {
            "transform": [
                {
                    "filter": "datum.country === 'Colombia'"
                }
            ],
            "mark": {
                "type": "text",
                "align": "left",
                "baseline": "middle",
                "dx": 18,
                "fontSize": 12,
                "fontWeight": 600,
                "color": "#2A1B14"
            },
            "encoding": {
                "text": {
                    "field": "country"
                }
            }
        },
        {
            "transform": [
                {
                    "filter": "datum.country === 'Ethiopia'"
                }
            ],
            "mark": {
                "type": "text",
                "align": "right",
                "baseline": "middle",
                "dx": -18,
                "fontSize": 12,
                "fontWeight": 600,
                "color": "#2A1B14"
            },
            "encoding": {
                "text": {
                    "field": "country"
                }
            }
        },
        {
            "data": {
                "values": [
                    {
                        "total": 220,
                        "arabica_pct": 95,
                        "label": "MOSTLY ARABICA"
                    }
                ]
            },
            "mark": {
                "type": "text",
                "align": "left",
                "baseline": "middle",
                "fontSize": 11,
                "fontWeight": 700,
                "fontStyle": "italic",
                "letterSpacing": 1.5,
                "color": "#2F5D50",
                "opacity": 0.7
            },
            "encoding": {
                "text": {
                    "field": "label",
                    "type": "nominal"
                }
            }
        },
        {
            "data": {
                "values": [
                    {
                        "total": 220,
                        "arabica_pct": 5,
                        "label": "MOSTLY ROBUSTA"
                    }
                ]
            },
            "mark": {
                "type": "text",
                "align": "left",
                "baseline": "middle",
                "fontSize": 11,
                "fontWeight": 700,
                "fontStyle": "italic",
                "letterSpacing": 1.5,
                "color": "#A53F2B",
                "opacity": 0.7
            },
            "encoding": {
                "text": {
                    "field": "label",
                    "type": "nominal"
                }
            }
        }
    ],
    "config": {
        "view": {
            "stroke": null
        }
    }
}