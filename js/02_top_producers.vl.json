{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "description": "Top 10 coffee producing countries in 2025, measured in 1000 60-kg bags of green coffee.",
    "height": "container",
    "padding": 16,
    "data": {
        "url": "data/coffee_top10_producers.csv"
    },
    "encoding": {
        "y": {
            "field": "country",
            "type": "nominal",
            "sort": "-x",
            "axis": {
                "title": null,
                "labelFontSize": 13,
                "labelPadding": 8,
                "domain": false,
                "ticks": false
            }
        },
        "x": {
            "field": "production_bags_1000",
            "type": "quantitative",
            "scale": {
                "domain": [0, 80000],
                "nice": false
            },
            "axis": {
                "title": "Production (1000 × 60-kg bags)",
                "titlePadding": 14,
                "titleFontSize": 12,
                "labelFontSize": 11,
                "values": [0, 20000, 40000, 60000, 80000],
                "format": "~s",
                "grid": true,
                "gridDash": [2, 4]
            }
        },
        "tooltip": [
            { "field": "country", "type": "nominal", "title": "Country" },
            { "field": "production_bags_1000", "type": "quantitative", "title": "Production (1000 bags)", "format": "," },
            { "field": "production_tonnes", "type": "quantitative", "title": "Production (tonnes)", "format": "," }
        ]
    },
    "layer": [
        {
            "mark": {
                "type": "bar",
                "cornerRadiusEnd": 2,
                "color": "#2F5D50"
            }
        },
        {
            "mark": {
                "type": "text",
                "align": "left",
                "baseline": "middle",
                "dx": 6,
                "fontSize": 12,
                "color": "#5C463A"
            },
            "encoding": {
                "text": {
                    "field": "production_bags_1000",
                    "type": "quantitative",
                    "format": ","
                }
            }
        }
    ]
}