    "description": "Bubble quadrant showing the personality of each Australian capital's coffee culture.",
    "height": "container",
    "padding": 16,
    "data": {
        "url": "data/city_cafes.csv"
    },
    "encoding": {
        "x": {
            "field": "chain_pct",
            "type": "quantitative",
            "scale": {
                "domain": [
                    3,
                    15
