                "nice": false
            },
            "axis": {
                "title": "Chain share of caf\u00e9s (%)",
                "titleFontSize": 12,
                "titlePadding": 14,
                "labelFontSize": 11,
                "values": [
                    4,
                    6,
                    8,
                    10,
                    12,
                    14
                ],
                "labelExpr": "datum.value + '%'",
                "grid": true,
                "gridDash": [
                    2,
                    4
                ]
            }
        },
        "y": {
            "field": "cafes_total",
            "type": "quantitative",
            "scale": {
                "domain": [
                    0,
                    3500
                ],
                "nice": false
            },
            "axis": {
                "title": "Total caf\u00e9s in metropolitan area",
                "titleFontSize": 12,
                "titlePadding": 10,
                "labelFontSize": 11,
                "values": [
                    0,
                    500,
                    1000,
                    1500,
                    2000,
                    2500,
                    3000,
                    3500
                ],
                "format": ",d",
                "grid": true,
                "gridDash": [
                    2,
                    4
                ]
            }
        }
    },
